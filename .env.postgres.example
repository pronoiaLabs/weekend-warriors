# Copy to .env.postgres at the repo root (gitignored) and fill in.
# Applied by make -C dlt-pipelines setup-postgres / run-postgres.
# See dlt-pipelines/MAKE-COMMANDS-POSTGRES.md and the repo-root SETUP.md.

# --- Snowflake Postgres instance (make setup-postgres-instance) --------------
# On a fresh account, setup-postgres-instance creates the instance from these
# and then WRITES PGHOST / PGPASSWORD below back into this file. On an account
# that already has the instance it skips the CREATE (it never drops or
# recreates) and only reconciles the ingress policy.
#
# The name is a quoted Snowflake identifier: spaces and case are preserved.
PG_INSTANCE_NAME=Weekend Warrior App
# BURST_S / BURST_M are the cheap dev families (max 100 GB storage, no HA);
# STANDARD_M and up for production. See the Snowflake Postgres instance-sizes doc.
PG_COMPUTE_FAMILY=BURST_M
PG_STORAGE_GB=25
PG_VERSION=18
# Instance-level ingress policy (Postgres-mode network rules). Created if
# missing; an existing one (e.g. Snowsight-created) is extended, never replaced.
PG_INGRESS_POLICY=POSTGRES_INGRESS_POLICY_WEEKEND_WARRIOR_APP
# Comma-separated client CIDRs allowed to reach :5432 (your laptop/office IPs).
# Required by setup-postgres-instance. curl -4 ifconfig.me tells you yours.
PG_CLIENT_CIDRS=
# Optional: pin the Snowflake egress CIDRs for the SPCS ingress rule instead of
# discovering them live via SYSTEM$GET_SNOWFLAKE_EGRESS_IP_RANGES().
# PG_SNOWFLAKE_EGRESS_CIDRS=

# Snowflake Postgres instance host (also the only host on POSTGRES_APP_EAI).
# Written by setup-postgres-instance; or copy it from
# DESC POSTGRES INSTANCE "<name>" (property 'host') / Snowsight.
PGHOST=xxxxx.region.aws.postgres.snowflake.app
PGPORT=5432
PGUSER=snowflake_admin
# The instance admin password. Written by setup-postgres-instance at CREATE
# time (Snowflake shows it exactly once). Lost it? Regenerate with:
#   ALTER POSTGRES INSTANCE "<name>" RESET ACCESS FOR 'snowflake_admin';
PGPASSWORD=
PGDATABASE=postgres

# Role dlt uses to replace-load app.app_copy. Generated by setup-postgres
# if you leave this blank; then copied into DLT_DB.OPS.POSTGRES_APP_COPY
# by make setup-postgres-secret. Never commit the value.
APP_COPY_WRITER_PASSWORD=

# Role both dashboards use to SELECT (app.app_copy / app.observability).
# Generated by make setup-postgres-api-password if you leave this blank.
# Never commit the value. Not the writer password, not the instance admin.
APP_API_PASSWORD=
