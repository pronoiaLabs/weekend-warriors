# Copy to .env.snowflake at the repo root (gitignored) and fill in what you have.
# Applied by: make -C dlt-pipelines setup-secrets CONFIRM=1
#
# Each non-empty value becomes one ALTER SECRET against the placeholder secret
# that `make setup-source SOURCE=<name>` / `make setup-ops` created. Empty
# values are skipped, so a partial file is fine and re-running never blanks a
# secret that was already set. Secret values cannot be read back from
# Snowflake; a successful pipeline run is the test.

# BallDontLie API keys (https://app.balldontlie.io). One key can serve multiple
# sports depending on your plan; paste it into each you ingest.
NFL_API_KEY=
NCAAF_API_KEY=

# Firecrawl (news scraping, https://firecrawl.dev) -> DLT_DB.OPS.FIRECRAWL_API_KEY
FIRECRAWL_API_KEY=

# Slack incoming-webhook PATH for failure alerts -> DLT_DB.OPS.SLACK_ALERTS_WEBHOOK.
# Only the part after https://hooks.slack.com/services/ (T.../B.../x...).
# See dlt-pipelines/sql/ops/09_alerting.sql for why the path, not the full URL.
SLACK_WEBHOOK_SECRET=
