-- =============================================================================
-- sql/postgres/07_set_api_password.sql.example
-- Purpose : Show the only statement that cannot live in git with a real value.
-- Apply   : make setup-postgres-api-password generates
--           sql/postgres/.generated/07_set_api_password.sql from
--           APP_API_PASSWORD (repo-root .env.postgres) and applies it.
--           That generated file is gitignored.
--
--   ALTER ROLE app_api PASSWORD '<value of APP_API_PASSWORD>';
-- =============================================================================

ALTER ROLE app_api PASSWORD 'APP_API_PASSWORD';
