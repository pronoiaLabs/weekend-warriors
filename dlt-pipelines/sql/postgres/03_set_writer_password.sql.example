-- =============================================================================
-- sql/postgres/03_set_writer_password.sql.example
-- Purpose : Show the only statement that cannot live in git with a real value.
-- Apply   : make setup-postgres generates sql/postgres/.generated/03_set_writer_password.sql
--           from APP_COPY_WRITER_PASSWORD (repo-root .env.postgres) and applies it.
--           That generated file is gitignored.
--
--   ALTER ROLE app_copy_writer PASSWORD '<value of APP_COPY_WRITER_PASSWORD>';
-- =============================================================================

ALTER ROLE app_copy_writer PASSWORD 'APP_COPY_WRITER_PASSWORD';
