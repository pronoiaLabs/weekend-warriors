# secrets.toml.example — copy to secrets.toml and fill in real values.
# secrets.toml is git-ignored; this example file is safe to commit.
#
# HOW SECRET REFS WORK
# In registry.yml, any credential value prefixed with "secret:" is treated as
# a dlt.secrets path (e.g. "secret:sources.nfl.api_key").
# Literal values (no prefix) are used as-is.

# ---------------------------------------------------------------------------
# DESTINATION: Snowflake
# ---------------------------------------------------------------------------
# You usually do NOT need this block:
#   * `make run`     -> DuckDB (no Snowflake creds)
#   * `make run-sf`  -> reuses your `snow` connection (deploy/snow_env.py)
#   * SPCS jobs      -> ambient OAuth token
# Only uncomment for static key-pair / password auth from a laptop or CI, and
# fill in a REAL key (the placeholder below is not valid and will fail).
# [destination.snowflake.credentials]
# host              = "YOUR_ACCOUNT_IDENTIFIER"   # dlt's "host" = Snowflake account identifier, e.g. xy12345.us-east-1
# username          = "DLT_LOADER"
# role              = "DLT_LOADER_ROLE"
# warehouse         = "DLT_WH"
# database          = "DLT_PROD_DB"
# private_key       = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# private_key_path  = "/path/to/rsa_key.p8"
# private_key_passphrase = ""   # set if the key is encrypted

# ---------------------------------------------------------------------------
# SOURCES: one block per league, all against api.balldontlie.io
# ---------------------------------------------------------------------------
# Referenced from the registries as "secret:sources.<name>.api_key". The equivalent
# environment variable is SOURCES__<NAME>__API_KEY, which is what an SPCS job binds a
# Snowflake SECRET to (see sql/sources/<name>/03_secrets.sql).
#
# ONE BALLDONTLIE ACCOUNT KEY WORKS FOR EVERY LEAGUE, so in practice both values below
# are the same string. They are separate entries anyway, because the registry binds a
# secret per source: sharing one would make every league fail together the day a key is
# rotated for one of them, and the failure would name the wrong sport.
#
# `make test` needs both to be present, even as junk values: several tests construct
# the dlt source object to inspect how a write disposition resolved, and building a
# rest_api source requires its auth config to RESOLVE even though no request is sent.
[sources.nfl]
api_key = "your_balldontlie_api_key"

[sources.wnba]
api_key = "your_balldontlie_api_key"

[sources.ncaaf]
api_key = "your_balldontlie_api_key"
